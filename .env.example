# Salin file ini menjadi .env.local lalu sesuaikan.

# Laragon (lokal): user root tanpa password
DATABASE_URL=mysql://root:@127.0.0.1:3306/atk_kahfi

# Isi true jika memakai MySQL cloud yang mewajibkan SSL
DB_SSL=false

# Teks acak panjang untuk menandatangani sesi login (WAJIB diganti di production)
AUTH_SECRET=ganti-dengan-teks-acak-yang-panjang

# Akun admin pertama (dibuat oleh: npm run db:setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAMA=Pemilik ATK Kahfi
